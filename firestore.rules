rules_version = '2';

// =============================================================
// REGRAS — Empório das Bebidas
// Modelo simples: o app entra autenticado (login anônimo do Firebase).
// Qualquer sessão autenticada pelo app pode ler/gravar os dados.
// Sem internet/sem sessão do app = sem acesso.
// =============================================================
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
