{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "**/.*",
      "**/node_modules/**",
      "README.md",
      ".firebaserc"
    ],
    "rewrites": [
      { "source": "/instalar",      "destination": "/instalar.html" },
      { "source": "/seed-produtos", "destination": "/seed-produtos.html" },
      { "source": "/cadastro",      "destination": "/cadastro.html" },
      { "source": "/conferencia",   "destination": "/conferencia-precos.html" },
      { "source": "/loja",          "destination": "/loja.html" },
      { "source": "/loja/**", "destination": "/loja.html" },
      { "source": "**",       "destination": "/index.html" }
    ],
    "headers": [
      {
        "source": "/quiosque.bat",
        "headers": [
          { "key": "Content-Type", "value": "application/octet-stream" },
          { "key": "Content-Disposition", "value": "attachment; filename=\"quiosque.bat\"" },
          { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
        ]
      },
      {
        "source": "**/*.@(js|css|svg|png|jpg|jpeg|webp)",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
        ]
      },
      {
        "source": "/sw.js",
        "headers": [
          { "key": "Cache-Control", "value": "no-store, max-age=0" }
        ]
      },
      {
        "source": "/loja-sw.js",
        "headers": [
          { "key": "Cache-Control", "value": "no-store, max-age=0" }
        ]
      },
      {
        "source": "/loja-manifest.json",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, max-age=0" }
        ]
      },
      {
        "source": "/manifest.json",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, max-age=0" }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
